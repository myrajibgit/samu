# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — real secret values live in Infisical, not on disk.
#
# One-time setup:
#   1. Install the CLI:            winget install infisical.infisical
#   2. Log in (opens browser):     infisical login
#   3. Link this folder (writes .infisical.json — safe to commit):  infisical init
#   4. Import the keys below into your Infisical project (drag & drop this file
#      onto the Secrets Overview page), then run builds through the CLI:
#         infisical run --env=dev -- ./gradlew assembleDebug
#
# NOTE: The Gemini key is OPTIONAL and currently INERT — PocketLLM runs models
# fully offline via llama.cpp. No runtime secret is required to build or use it.
# ─────────────────────────────────────────────────────────────────────────────

# Optional; unused by the current codebase. Kept for future cloud-assist work.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Release signing — read by app/build.gradle.kts via System.getenv() for
# release builds only. Put real values in Infisical, never in this file:
#   infisical run --env=dev -- ./gradlew assembleRelease
KEYSTORE_PATH=
STORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
